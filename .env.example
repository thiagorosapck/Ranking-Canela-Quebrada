# --- Frontend (público; vai para o bundle) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# Base path do GitHub Pages. Use "/NOME-DO-REPO/" em produção; "./" funciona em qualquer lugar (HashRouter).
VITE_BASE=./

# --- Apenas para CLI / Edge Functions (NUNCA use prefixo VITE_ aqui) ---
# Configure no Supabase com: supabase secrets set --env-file ./supabase/.env
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_VALIDATION_CHANNEL_ID=
# SITE_URL=https://SEU-USUARIO.github.io/NOME-DO-REPO/
